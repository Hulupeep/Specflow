{
  "name": "@colmbyrne/specflow",
  "version": "0.11.1",
  "description": "Specs that enforce themselves. Contract tests, journey hooks, and agent orchestration for LLM-driven development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hulupeep/Specflow.git"
  },
  "bin": {
    "specflow": "bin/specflow.js"
  },
  "files": [
    "bin/",
    "hooks/",
    "templates/",
    "agents/",
    "skills/",
    "scripts/",
    "docs/gate-d.md",
    "docs/advisory-review.md",
    "docs/contracts/feature-review.yml",
    "setup-project.sh",
    "install-hooks.sh",
    "verify-setup.sh",
    "CLAUDE.md",
    "CLAUDE-MD-TEMPLATE.md",
    "CONTRACT-SCHEMA.md",
    "CONTRACT-SCHEMA-EXTENSIONS.md",
    "MODEL_ROUTING.md",
    "CHANGELOG.md",
    "SKILL.md",
    "LLM-MASTER-PROMPT.md",
    "plugins/codex/specflow/",
    "plugins/claude-code/specflow/",
    "docs/onboarding.md",
    "docs/contracts/feature_install_ux.yml"
  ],
  "scripts": {
    "prepack": "node scripts/sync-loop-templates.cjs --check && node scripts/normalize-eol.cjs",
    "prepublishOnly": "node scripts/sync-loop-templates.cjs --check && node scripts/normalize-eol.cjs",
    "sync:loops": "node scripts/sync-loop-templates.cjs",
    "normalize": "node scripts/normalize-eol.cjs",
    "postinstall": "echo '' && echo '\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557' && echo '\u2551  @colmbyrne/specflow installed                       \u2551' && echo '\u2560\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2563' && echo '\u2551                                                       \u2551' && echo '\u2551  Run in EACH project you want to enforce:             \u2551' && echo '\u2551                                                       \u2551' && echo '\u2551    npx @colmbyrne/specflow init .                     \u2551' && echo '\u2551                                                       \u2551' && echo '\u2551  This creates hooks, contracts, agents, tests, and    \u2551' && echo '\u2551  CLAUDE.md (or appends rules to your existing one).   \u2551' && echo '\u2551  Then fill in the Project Context in CLAUDE.md.       \u2551' && echo '\u2551                                                       \u2551' && echo '\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d' && echo ''",
    "test": "jest --no-coverage",
    "test:contracts": "jest tests/contracts/ --no-coverage",
    "test:hooks": "jest tests/hooks/ --no-coverage",
    "test:schema": "jest tests/schema/ --no-coverage",
    "test:verbose": "jest --verbose --no-coverage",
    "test:compile": "jest tests/compile/ --no-coverage",
    "compile:journeys": "node scripts/specflow-compile.cjs",
    "verify:graph": "node scripts/verify-graph.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "js-yaml": "^4.3.2",
    "zod": "4.6.7"
  }
}
