{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "jobId",
    "phase",
    "recipeId",
    "generation",
    "expectedBackendIdentity",
    "productBuildReceipt",
    "inputManifest",
    "resourceProfile"
  ],
  "properties": {
    "schema": {
      "const": "specflow.backend-request/v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "phase": {
      "enum": [
        "baseline",
        "after"
      ]
    },
    "recipeId": {
      "const": "heystax-supabase-v1"
    },
    "generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "expectedBackendIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "productBuildReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "resourceProfile": {
      "const": "heystax-backend-v1"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
