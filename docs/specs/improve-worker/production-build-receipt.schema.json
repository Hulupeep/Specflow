{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "jobId",
    "inputSha256",
    "producerIdentitySha256",
    "output",
    "buildIdSha256"
  ],
  "properties": {
    "schema": {
      "const": "specflow.production-build-receipt/v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producerIdentitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "manifestSha256"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobId",
            "sourceContainerId",
            "recipeSha256",
            "sourceInputSha256"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
            },
            "sourceContainerId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceInputSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "buildIdSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
