{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attemptId",
    "attemptSha256",
    "phase",
    "finishedAtMs",
    "state",
    "cause",
    "resources",
    "credentialEnvelopeRemoved",
    "backendTerminalSha256",
    "productReceiptSha256"
  ],
  "properties": {
    "schema": {
      "const": "specflow.backend-attempt-terminal/v1"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "attemptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "phase": {
      "type": "string",
      "pattern": "^(?:baseline|after|dev-r(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991))$(?![\\s\\S])"
    },
    "finishedAtMs": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "cleaned",
        "operator_required"
      ]
    },
    "cause": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^backend_[a-z_]+$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "intentSha256",
          "id",
          "status"
        ],
        "properties": {
          "slot": {
            "enum": [
              "source-producer",
              "build",
              "app",
              "checker",
              "database",
              "authMigration",
              "auth",
              "rest",
              "gateway",
              "seed"
            ]
          },
          "intentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "removed",
              "absent",
              "unconfirmed",
              "foreign"
            ]
          }
        }
      },
      "maxItems": 10
    },
    "credentialEnvelopeRemoved": {
      "type": "boolean"
    },
    "backendTerminalSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "productReceiptSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "cleaned"
          }
        }
      },
      "then": {
        "properties": {
          "credentialEnvelopeRemoved": {
            "const": true
          },
          "resources": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "removed",
                    "absent"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "operator_required"
          }
        }
      },
      "then": {
        "properties": {
          "cause": {
            "const": "backend_cleanup_unconfirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cause": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "cleaned"
          },
          "backendTerminalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          },
          "productReceiptSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
