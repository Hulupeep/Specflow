{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "jobId",
    "runId",
    "attemptId",
    "phase",
    "contractSha256",
    "constructionSha256",
    "authoritySha256",
    "owner",
    "startedAtMs",
    "deadlineAtMs"
  ],
  "properties": {
    "schema": {
      "const": "specflow.backend-attempt/v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$(?![\\s\\S])"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$(?![\\s\\S])"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "phase": {
      "type": "string",
      "pattern": "^(?:baseline|after|dev-r(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991))$(?![\\s\\S])"
    },
    "contractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "constructionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "authoritySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_id",
        "pid",
        "start",
        "group"
      ],
      "properties": {
        "boot_id": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 2
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]+$(?![\\s\\S])"
        },
        "group": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "startedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "deadlineAtMs": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
